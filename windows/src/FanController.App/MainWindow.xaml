<Window
    x:Class="FanController.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:FanController.App.Controls"
    Title="FanController — contrôle local BLE">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#101827">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="#192538"/>
                <Setter Property="BorderBrush" Value="#304058"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="20,14"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Padding="28,22" ColumnSpacing="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE9CA;" Foreground="#5DD9C1" FontSize="32"/>
                    <TextBlock Text="FanController" FontSize="30" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding ConnectionLabel}" Foreground="#AABBD2" AutomationProperties.AutomationId="ConnectionStatus"/>
                <TextBlock Text="{Binding Firmware}" Foreground="#5DD9C1"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
                <ProgressRing IsActive="{Binding Busy}" Width="20" Height="20" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
        <InfoBar Grid.Row="1" Margin="28,0" IsOpen="{Binding HasError}" IsClosable="False"
                 Severity="Error" Title="Opération interrompue" Message="{Binding Error}"/>
        <Pivot Grid.Row="2">
            <Pivot.Resources>
                <Thickness x:Key="PivotHeaderItemMargin">28,0,12,0</Thickness>
            </Pivot.Resources>
            <PivotItem Header="Tableau de bord" Margin="0" AutomationProperties.AutomationId="DashboardTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Spacing="16" Padding="28,0,28,24">
                        <TextBlock Text="{Binding LastUpdate}" Foreground="#AABBD2"/>
                        <ItemsControl ItemsSource="{Binding Sensors}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><charts:TwoColumnPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{Binding Title}" Foreground="#AABBD2"/>
                                            <TextBlock Text="{Binding Temperature}" FontSize="40" FontWeight="SemiBold" Foreground="#5DD9C1"/>
                                            <TextBlock Text="{Binding DisplayDetails}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Ventilation" FontSize="22" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding FanReadings}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><charts:TwoColumnPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding Title}" Foreground="#AABBD2"/>
                                            <TextBlock Text="{Binding Rpm}" FontSize="26" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DisplayDetails}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Les valeurs restent affichées après une coupure, mais ne sont alors plus actuelles. La régulation reste autonome sur l’ESP32."
                                   TextWrapping="Wrap" Foreground="#AABBD2"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Historique" Margin="0" AutomationProperties.AutomationId="HistoryTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Padding="28,0,28,24" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <ComboBox ItemsSource="{Binding History.Devices}" SelectedItem="{Binding History.SelectedDevice, Mode=TwoWay}"
                                      DisplayMemberPath="Label" Width="240" PlaceholderText="Historique du contrôleur"/>
                            <ComboBox SelectedIndex="{Binding History.RangeIndex, Mode=TwoWay}" Width="190" AutomationProperties.Name="Période de l’historique">
                                <ComboBoxItem Content="Dernière heure"/><ComboBoxItem Content="Dernières 24 heures"/>
                                <ComboBoxItem Content="7 derniers jours"/><ComboBoxItem Content="30 derniers jours"/>
                            </ComboBox>
                            <Button Content="Actualiser" Command="{Binding History.RefreshCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding History.Message}" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Températures • °C" FontSize="22" FontWeight="SemiBold"/>
                                <charts:LineChart Series="{Binding History.Temperatures}" IsTimeAxis="True"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Vitesses • tr/min" FontSize="22" FontWeight="SemiBold"/>
                                <charts:LineChart Series="{Binding History.Rpm}" IsTimeAxis="True"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Seules les mesures reçues pendant une connexion sont enregistrées, y compris lorsque la fenêtre est masquée. Les périodes hors connexion ne sont pas reconstituées."
                                   TextWrapping="Wrap" Foreground="#AABBD2"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Paramètres" Margin="0" AutomationProperties.AutomationId="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" AutomationProperties.AutomationId="SettingsScrollViewer">
                    <StackPanel Padding="28,0,28,24" Spacing="16">
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <CheckBox Content="Lancer au démarrage de Windows"
                                          IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="WindowsStartupCheckBox"/>
                                <TextBlock Text="À l’ouverture de votre session, l’application démarre dans le systray et se reconnecte au dernier contrôleur."
                                           Foreground="#AABBD2" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Connexion au contrôleur" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ConnectionHeading}" VerticalAlignment="Center"
                                               Foreground="#AABBD2" AutomationProperties.AutomationId="ConnectionHeading"/>
                                </Grid>
                                <StackPanel Spacing="6" Visibility="{Binding ConnectedDetailsVisibility}"
                                            AutomationProperties.AutomationId="ConnectedDetails">
                                    <TextBlock Text="{Binding ControllerName}" FontSize="18" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="ControllerName"/>
                                    <TextBlock Text="{Binding ControllerIdentifier}" IsTextSelectionEnabled="True"
                                           Foreground="#AABBD2" AutomationProperties.AutomationId="ControllerIdentifier"/>
                                    <TextBlock Text="{Binding LinkQuality}" AutomationProperties.AutomationId="LinkQuality"
                                               ToolTipService.ToolTip="Signal reçu par l’ESP32 : plus la valeur en dBm est proche de zéro, plus le signal est fort."/>
                                </StackPanel>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{Binding ConnectionVisibility}">
                                    <Button Content="Rechercher (15 s)" Command="{Binding ScanCommand}" AutomationProperties.AutomationId="ScanButton"/>
                                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                              DisplayMemberPath="Label" PlaceholderText="Choisir le contrôleur" MinWidth="320"
                                              AutomationProperties.Name="Contrôleur BLE"/>
                                    <Button Content="Connecter / appairer" Command="{Binding ConnectCommand}"
                                            Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="ConnectButton"/>
                                </StackPanel>
                                <Button Content="{Binding DisconnectLabel}" Command="{Binding DisconnectCommand}"
                                        Visibility="{Binding DisconnectVisibility}" AutomationProperties.AutomationId="DisconnectButton"/>
                                <Expander Header="Premier appairage : comment faire ?" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Visibility="{Binding ConnectionVisibility}" AutomationProperties.AutomationId="PairingHelp">
                                    <TextBlock Text="1. Sur l’ESP32, maintenez BOOT 2 secondes puis relâchez.&#x0a;2. Dans les 60 secondes, recherchez le contrôleur, sélectionnez-le puis cliquez sur Connecter / appairer.&#x0a;Les connexions suivantes sont automatiques, sans appui sur BOOT."
                                               TextWrapping="Wrap" Foreground="#AABBD2" AutomationProperties.AutomationId="PairingInstructions"/>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="16" Visibility="{Binding ConnectedDetailsVisibility}"
                                    AutomationProperties.AutomationId="ControllerSettings">
                        <TextBlock Text="Courbes de ventilation" FontSize="24" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Interpolation linéaire entre les points. Activez l’édition pour modifier les courbes ; désactiver l’édition conserve le brouillon."
                                       TextWrapping="Wrap" Foreground="#AABBD2" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding CurveEditing, Mode=TwoWay}"
                                          OnContent="Édition" OffContent="Lecture" HorizontalAlignment="Right"
                                          MinWidth="0" VerticalAlignment="Center"
                                          AutomationProperties.Name="Édition des courbes" AutomationProperties.AutomationId="CurveEditingToggle"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>
                                            <charts:LineChart Series="{Binding Curve}" Editor="{Binding}"
                                                              IsEditing="{Binding IsEditing}" AutomationProperties.AutomationId="EditableCurve"
                                                              AutomationProperties.Name="{Binding Title}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Commande des ventilateurs" FontSize="22" FontWeight="SemiBold"/>
                        <UserControl IsEnabled="{Binding CanEdit}">
                            <ItemsControl ItemsSource="{Binding Fans}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                <TextBlock Text="{Binding Title}" Width="150" VerticalAlignment="Center"/>
                                                <ComboBox SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" Width="180" AutomationProperties.Name="Mode du ventilateur">
                                                    <ComboBoxItem Content="Automatique"/><ComboBoxItem Content="Fixe"/>
                                                </ComboBox>
                                                <TextBox Text="{Binding Duty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" AutomationProperties.Name="PWM fixe en pourcentage"/>
                                                <TextBlock Text="% (mode fixe)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </UserControl>
                        <StackPanel Visibility="{Binding CurveEditorVisibility}" Spacing="12" AutomationProperties.AutomationId="CurveEditorPanel">
                            <TextBlock Text="Édition des points" FontSize="22" Foreground="#FFB86B" AutomationProperties.AutomationId="CurveEditorTitle"/>
                            <UserControl IsEnabled="{Binding CanEdit}">
                                <ItemsControl ItemsSource="{Binding Profiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Température (°C)                       PWM (%)"/>
                                                    <ItemsControl ItemsSource="{Binding Points}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnSpacing="16" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="140"/>
                                                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox Text="{Binding Temperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="180" AutomationProperties.Name="Température du point"/>
                                                                    <TextBox Grid.Column="1" Text="{Binding Duty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140" AutomationProperties.Name="PWM du point"/>
                                                                    <Button Grid.Column="3" Command="{Binding RemoveCommand}" ToolTipService.ToolTip="Supprimer ce point"
                                                                            AutomationProperties.Name="Supprimer ce point">
                                                                        <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </UserControl>
                            <TextBlock Text="2 à 8 points • −20 à 120 °C, strictement croissants • PWM 0 à 100 %, non décroissant." TextWrapping="Wrap"/>
                            <TextBlock Text="Sur le graphique : + ajoute un point sur la courbe ; cliquez sur un point pour le sélectionner, puis sur la corbeille pour le supprimer. Glissez-le pour ajuster température et PWM. Les corbeilles des lignes restent disponibles."
                                       TextWrapping="Wrap" Foreground="#AABBD2"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SettingsSummary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ConfigurationMessage}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ConfigurationMessage"/>
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFB86B" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="1. Appliquer en RAM" Command="{Binding ApplyCommand}" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="ApplyButton"/>
                            <Button Content="2. Enregistrer sur l’ESP32" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SaveButton"/>
                            <Button Content="Annuler les modifications" Command="{Binding AdoptCommand}" AutomationProperties.AutomationId="RevertButton"/>
                        </StackPanel>
                        <TextBlock Text="Appliquer change la ventilation immédiatement. Enregistrer conserve ces réglages après redémarrage. Les sécurités thermiques restent prioritaires."
                                   TextWrapping="Wrap" Foreground="#AABBD2"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
        <Grid Grid.Row="3" Padding="28,12" Background="#192538">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Fermer ou réduire → zone de notification • l’acquisition continue tant que le PC est connecté"
                       VerticalAlignment="Center" FontSize="12" Foreground="#AABBD2" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="Quitter" Click="QuitClicked" AutomationProperties.AutomationId="QuitButton"/>
        </Grid>
    </Grid>
</Window>
