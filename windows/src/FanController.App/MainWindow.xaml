<Window
    x:Class="FanController.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:FanController.App.Controls"
    Title="FanController — Local BLE control">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#101827">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="#192538"/>
                <Setter Property="BorderBrush" Value="#304058"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="20,14"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Padding="28,22" ColumnSpacing="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE9CA;" Foreground="#5DD9C1" FontSize="32"/>
                    <TextBlock Text="FanController" FontSize="30" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding ConnectionLabel}" Foreground="#AABBD2" AutomationProperties.AutomationId="ConnectionStatus"/>
                <TextBlock Text="{Binding Firmware}" Foreground="#5DD9C1"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
                <ProgressRing IsActive="{Binding Busy}" Width="20" Height="20" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Margin="28,0,28,16" Padding="16,12" CornerRadius="5"
                Background="#4A2929" Visibility="{Binding ErrorVisibility}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE783;" Foreground="#FF9292" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Operation interrupted" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ErrorDetailsText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Foreground="#F4DCDC"/>
                </StackPanel>
            </Grid>
        </Border>
        <Pivot Grid.Row="2">
            <Pivot.Resources>
                <Thickness x:Key="PivotHeaderItemMargin">28,0,12,0</Thickness>
            </Pivot.Resources>
            <PivotItem Header="Dashboard" Margin="0" AutomationProperties.AutomationId="DashboardTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Spacing="16" Padding="28,0,28,24">
                        <TextBlock Text="{Binding LastUpdate}" Foreground="#AABBD2"/>
                        <ItemsControl ItemsSource="{Binding Sensors}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><charts:TwoColumnPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{Binding Title}" Foreground="#AABBD2"/>
                                            <TextBlock Text="{Binding Temperature}" FontSize="40" FontWeight="SemiBold" Foreground="#5DD9C1"/>
                                            <TextBlock Text="{Binding DisplayDetails}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Cooling" FontSize="22" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding FanReadings}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><charts:TwoColumnPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding Title}" Foreground="#AABBD2"/>
                                            <TextBlock Text="{Binding Rpm}" FontSize="26" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DisplayDetails}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Values remain visible after a disconnect, but are no longer current. The ESP32 continues regulating independently."
                                   TextWrapping="Wrap" Foreground="#AABBD2"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="History" Margin="0" AutomationProperties.AutomationId="HistoryTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Padding="28,0,28,24" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <ComboBox ItemsSource="{Binding History.Devices}" SelectedItem="{Binding History.SelectedDevice, Mode=TwoWay}"
                                      DisplayMemberPath="Label" Width="240" PlaceholderText="Controller history"/>
                            <ComboBox SelectedIndex="{Binding History.RangeIndex, Mode=TwoWay}" Width="190" AutomationProperties.Name="History range">
                                <ComboBoxItem Content="Last hour"/><ComboBoxItem Content="Last 24 hours"/>
                                <ComboBoxItem Content="Last 7 days"/><ComboBoxItem Content="Last 30 days"/>
                            </ComboBox>
                            <Button Content="Refresh" Command="{Binding History.RefreshCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding History.Message}" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Temperatures • °C" FontSize="22" FontWeight="SemiBold"/>
                                <charts:LineChart Series="{Binding History.Temperatures}" IsTimeAxis="True"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Speeds • RPM" FontSize="22" FontWeight="SemiBold"/>
                                <charts:LineChart Series="{Binding History.Rpm}" IsTimeAxis="True"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Only measurements received while connected are recorded, including when the window is hidden. Offline periods are not reconstructed."
                                   TextWrapping="Wrap" Foreground="#AABBD2"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Settings" Margin="0" AutomationProperties.AutomationId="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" AutomationProperties.AutomationId="SettingsScrollViewer">
                    <StackPanel Padding="28,0,28,24" Spacing="16">
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Language" FontSize="20" FontWeight="SemiBold"/>
                                <ComboBox x:Name="LanguageSelector" SelectedIndex="0" SelectionChanged="LanguageChanged" Width="220">
                                    <ComboBoxItem Content="English"/><ComboBoxItem Content="Français"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <CheckBox Content="Launch when Windows starts"
                                          IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="WindowsStartupCheckBox"/>
                                <TextBlock Text="At sign-in, the app starts in the system tray and reconnects to the last controller."
                                           Foreground="#AABBD2" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Controller connection" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ConnectionHeading}" VerticalAlignment="Center"
                                               Foreground="#AABBD2" AutomationProperties.AutomationId="ConnectionHeading"/>
                                </Grid>
                                <StackPanel Spacing="6" Visibility="{Binding ConnectedDetailsVisibility}"
                                            AutomationProperties.AutomationId="ConnectedDetails">
                                    <TextBlock Text="{Binding ControllerName}" FontSize="18" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="ControllerName"/>
                                    <TextBlock Text="{Binding ControllerIdentifier}" IsTextSelectionEnabled="True"
                                           Foreground="#AABBD2" AutomationProperties.AutomationId="ControllerIdentifier"/>
                                    <TextBlock Text="{Binding LinkQuality}" AutomationProperties.AutomationId="LinkQuality"
                                               ToolTipService.ToolTip="Signal received by the ESP32: values closer to zero dBm indicate a stronger signal."/>
                                </StackPanel>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{Binding ConnectionVisibility}">
                                    <Button Content="Search (15 s)" Command="{Binding ScanCommand}" AutomationProperties.AutomationId="ScanButton"/>
                                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                              DisplayMemberPath="Label" PlaceholderText="Select a controller" MinWidth="320"
                                              AutomationProperties.Name="BLE controller"/>
                                    <Button Content="Connect / pair" Command="{Binding ConnectCommand}"
                                            Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="ConnectButton"/>
                                </StackPanel>
                                <Button Content="{Binding DisconnectLabel}" Command="{Binding DisconnectCommand}"
                                        Visibility="{Binding DisconnectVisibility}" AutomationProperties.AutomationId="DisconnectButton"/>
                                <Expander Header="First-time pairing instructions" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Visibility="{Binding ConnectionVisibility}" AutomationProperties.AutomationId="PairingHelp">
                                    <TextBlock Text="1. On the ESP32, hold BOOT for 2 seconds, then release.&#x0a;2. Within 60 seconds, search for the controller, select it, then click Connect / pair.&#x0a;Later connections are automatic; BOOT is not needed again."
                                               TextWrapping="Wrap" Foreground="#AABBD2" AutomationProperties.AutomationId="PairingInstructions"/>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="16" Visibility="{Binding ConnectedDetailsVisibility}"
                                    AutomationProperties.AutomationId="ControllerSettings">
                        <TextBlock Text="Fan curves" FontSize="24" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="The curve is linearly interpolated between points. Enable editing to change curves; disabling it keeps the draft."
                                       TextWrapping="Wrap" Foreground="#AABBD2" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding CurveEditing, Mode=TwoWay}"
                                          OnContent="Edit" OffContent="View" HorizontalAlignment="Right"
                                          MinWidth="0" VerticalAlignment="Center"
                                          AutomationProperties.Name="Curve editing" AutomationProperties.AutomationId="CurveEditingToggle"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>
                                            <charts:LineChart Series="{Binding Curve}" Editor="{Binding}"
                                                              IsEditing="{Binding IsEditing}" AutomationProperties.AutomationId="EditableCurve"
                                                              AutomationProperties.Name="{Binding Title}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Fan control" FontSize="22" FontWeight="SemiBold"/>
                        <UserControl IsEnabled="{Binding CanEdit}">
                            <ItemsControl ItemsSource="{Binding Fans}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                <TextBlock Text="{Binding Title}" Width="150" VerticalAlignment="Center"/>
                                                <ComboBox SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" Width="180" AutomationProperties.Name="Fan mode">
                                                    <ComboBoxItem Content="Automatic"/><ComboBoxItem Content="Fixed"/>
                                                </ComboBox>
                                                <TextBox Text="{Binding Duty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" AutomationProperties.Name="Fixed PWM percentage"/>
                                                <TextBlock Text="% (fixed mode)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </UserControl>
                        <StackPanel Visibility="{Binding CurveEditorVisibility}" Spacing="12" AutomationProperties.AutomationId="CurveEditorPanel">
                            <TextBlock Text="Edit points" FontSize="22" Foreground="#FFB86B" AutomationProperties.AutomationId="CurveEditorTitle"/>
                            <UserControl IsEnabled="{Binding CanEdit}">
                                <ItemsControl ItemsSource="{Binding Profiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Temperature (°C)                       PWM (%)"/>
                                                    <ItemsControl ItemsSource="{Binding Points}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnSpacing="16" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="140"/>
                                                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox Text="{Binding Temperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="180" AutomationProperties.Name="Point temperature"/>
                                                                    <TextBox Grid.Column="1" Text="{Binding Duty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140" AutomationProperties.Name="Point PWM"/>
                                                                    <Button Grid.Column="3" Command="{Binding RemoveCommand}" ToolTipService.ToolTip="Delete this point"
                                                                            AutomationProperties.Name="Delete this point">
                                                                        <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </UserControl>
                            <TextBlock Text="2 to 8 points • −20 to 120 °C, strictly increasing • PWM 0 to 100%, non-decreasing." TextWrapping="Wrap"/>
                            <TextBlock Text="On the chart: + adds a point; select a point, then use the trash button to delete it. Drag points to adjust temperature and PWM. Row delete buttons are also available."
                                       TextWrapping="Wrap" Foreground="#AABBD2"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SettingsSummary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ConfigurationMessage}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ConfigurationMessage"/>
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFB86B" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="1. Apply to RAM" Command="{Binding ApplyCommand}" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="ApplyButton"/>
                            <Button Content="2. Save to ESP32" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SaveButton"/>
                            <Button Content="Discard changes" Command="{Binding AdoptCommand}" AutomationProperties.AutomationId="RevertButton"/>
                        </StackPanel>
                        <TextBlock Text="Apply changes fan behavior immediately. Save keeps these settings after restart. Thermal safety always takes priority."
                                   TextWrapping="Wrap" Foreground="#AABBD2"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
        <Grid Grid.Row="3" Padding="28,12" Background="#192538">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Close or minimize → system tray • acquisition continues while the PC is connected"
                       VerticalAlignment="Center" FontSize="12" Foreground="#AABBD2" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="Quit" Click="QuitClicked" AutomationProperties.AutomationId="QuitButton"/>
        </Grid>
    </Grid>
</Window>
