<Window
    x:Class="FanController.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:FanController.App.Controls"
    Title="FanController — contrôle local BLE">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#101827">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="#192538"/>
                <Setter Property="BorderBrush" Value="#304058"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="20"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Padding="28,22" ColumnSpacing="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE9CA;" Foreground="#5DD9C1" FontSize="32"/>
                    <TextBlock Text="FanController" FontSize="30" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding ConnectionLabel}" Foreground="#AABBD2"/>
                <TextBlock Text="{Binding Firmware}" Foreground="#5DD9C1"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
                <ToggleSwitch Header="Mode avancé / diagnostic" IsOn="{Binding AdvancedMode, Mode=TwoWay}" OnContent="Avancé" OffContent="Simple"/>
                <ProgressRing IsActive="{Binding Busy}" Width="20" Height="20" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
        <InfoBar Grid.Row="1" Margin="28,0" IsOpen="{Binding HasError}" IsClosable="False"
                 Severity="Error" Title="Opération interrompue" Message="{Binding Error}"/>
        <Pivot Grid.Row="2" Margin="16,0">
            <PivotItem Header="Tableau de bord" AutomationProperties.AutomationId="DashboardTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Padding="12,8,12,24">
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Votre contrôleur, en direct" FontSize="22" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Rechercher (15 s)" Command="{Binding ScanCommand}" AutomationProperties.AutomationId="ScanButton"/>
                                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                              DisplayMemberPath="Label" PlaceholderText="Choisir le contrôleur" MinWidth="320"
                                              AutomationProperties.Name="Contrôleur BLE"/>
                                    <Button Content="Connecter / appairer" Command="{Binding ConnectCommand}"
                                            Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="ConnectButton"/>
                                    <Button Content="Déconnecter" Command="{Binding DisconnectCommand}" AutomationProperties.AutomationId="DisconnectButton"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <TextBlock Text="Premier appairage : maintenir BOOT 2 s puis relâcher sur l’ESP32 ; connecter sous 60 s. Les connexions suivantes utilisent les clés mémorisées."
                                           TextWrapping="Wrap" Foreground="#AABBD2"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LastUpdate}" Foreground="#AABBD2"/>
                        <ItemsControl ItemsSource="{Binding Sensors}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Width="490" Margin="0,0,12,12">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{Binding Title}" Foreground="#AABBD2"/>
                                            <TextBlock Text="{Binding Temperature}" FontSize="40" FontWeight="SemiBold" Foreground="#5DD9C1"/>
                                            <TextBlock Text="{Binding DisplayDetails}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Ventilation" FontSize="22" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding FanReadings}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Width="490" Margin="0,0,12,12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding Title}" Foreground="#AABBD2"/>
                                            <TextBlock Text="{Binding Rpm}" FontSize="26" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DisplayDetails}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Les valeurs restent affichées après une coupure, mais ne sont alors plus actuelles. La régulation reste autonome sur l’ESP32."
                                   TextWrapping="Wrap" Foreground="#AABBD2"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Historique" AutomationProperties.AutomationId="HistoryTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="12,8,12,24" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <ComboBox ItemsSource="{Binding History.Devices}" SelectedItem="{Binding History.SelectedDevice, Mode=TwoWay}"
                                      DisplayMemberPath="Label" Width="240" PlaceholderText="Historique du contrôleur"/>
                            <ComboBox SelectedIndex="{Binding History.RangeIndex, Mode=TwoWay}" Width="190" AutomationProperties.Name="Période de l’historique">
                                <ComboBoxItem Content="Dernière heure"/><ComboBoxItem Content="Dernières 24 heures"/>
                                <ComboBoxItem Content="7 derniers jours"/><ComboBoxItem Content="30 derniers jours"/>
                            </ComboBox>
                            <Button Content="Actualiser" Command="{Binding History.RefreshCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding History.Message}" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Températures • °C" FontSize="22" FontWeight="SemiBold"/>
                                <charts:LineChart Series="{Binding History.Temperatures}" IsTimeAxis="True"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Vitesses • tr/min" FontSize="22" FontWeight="SemiBold"/>
                                <charts:LineChart Series="{Binding History.Rpm}" IsTimeAxis="True"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Seules les mesures reçues pendant une connexion sont enregistrées, y compris lorsque la fenêtre est masquée. Les périodes hors connexion ne sont pas reconstituées."
                                   TextWrapping="Wrap" Foreground="#AABBD2"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Paramètres" AutomationProperties.AutomationId="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="12,8,12,24" Spacing="16">
                        <TextBlock Text="Courbes de ventilation" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Interpolation linéaire entre les points. Activez le mode avancé pour éditer les points des courbes." TextWrapping="Wrap" Foreground="#AABBD2"/>
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>
                                            <charts:LineChart Series="{Binding Curve}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Commande des ventilateurs" FontSize="22" FontWeight="SemiBold"/>
                        <UserControl IsEnabled="{Binding CanEdit}">
                            <ItemsControl ItemsSource="{Binding Fans}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                <TextBlock Text="{Binding Title}" Width="150" VerticalAlignment="Center"/>
                                                <ComboBox SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" Width="180" AutomationProperties.Name="Mode du ventilateur">
                                                    <ComboBoxItem Content="Automatique"/><ComboBoxItem Content="Fixe"/>
                                                </ComboBox>
                                                <TextBox Text="{Binding Duty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" AutomationProperties.Name="PWM fixe en pourcentage"/>
                                                <TextBlock Text="% (mode fixe)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </UserControl>
                        <StackPanel Visibility="{Binding AdvancedVisibility}" Spacing="12">
                            <TextBlock Text="Avancé • édition des points" FontSize="22" Foreground="#FFB86B"/>
                            <UserControl IsEnabled="{Binding CanEdit}">
                                <ItemsControl ItemsSource="{Binding Profiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Température (°C)                       PWM (%)"/>
                                                    <ItemsControl ItemsSource="{Binding Points}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,6">
                                                                    <TextBox Text="{Binding Temperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="180" AutomationProperties.Name="Température du point"/>
                                                                    <TextBox Text="{Binding Duty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140" AutomationProperties.Name="PWM du point"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <Button Content="Ajouter un point" Command="{Binding AddCommand}"/>
                                                        <Button Content="Retirer le dernier point" Command="{Binding RemoveCommand}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </UserControl>
                            <TextBlock Text="2 à 8 points • −20 à 120 °C, strictement croissants • PWM 0 à 100 %, non décroissant." TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Storage}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Relire l’état distant" Command="{Binding ReadCommand}"/>
                                <Button Content="Abandonner le brouillon local" Command="{Binding AdoptCommand}"/>
                                <Button Content="Valeurs d’usine en RAM" Command="{Binding DefaultsCommand}"/>
                            </StackPanel>
                            <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="Appairage avec présence physique"
                                     Message="Le bouton autorise le premier PC ; les sessions sont chiffrées. Sans code, Just Works ne protège pas d’une interception active au premier appairage. BOOT 10 s puis relâcher révoque le PC ; supprimer aussi l’appairage Windows."/>
                        </StackPanel>
                        <TextBlock Text="{Binding LocalState}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFB86B" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="1. Appliquer en RAM" Command="{Binding ApplyCommand}" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="ApplyButton"/>
                            <Button Content="2. Enregistrer sur l’ESP32" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SaveButton"/>
                        </StackPanel>
                        <TextBlock Text="Appliquer modifie le fonctionnement immédiatement ; Enregistrer rend ces réglages persistants. Les sécurités thermiques restent prioritaires. Une rupture pendant l’application peut laisser une configuration partielle : relire avant de réessayer."
                                   TextWrapping="Wrap" Foreground="#AABBD2"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
        <Grid Grid.Row="3" Padding="28,12" Background="#192538">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Fermer ou réduire → zone de notification • l’acquisition continue tant que le PC est connecté"
                       VerticalAlignment="Center" FontSize="12" Foreground="#AABBD2" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="Quitter" Click="QuitClicked" AutomationProperties.AutomationId="QuitButton"/>
        </Grid>
    </Grid>
</Window>
