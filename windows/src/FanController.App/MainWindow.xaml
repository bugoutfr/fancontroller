<Window
    x:Class="FanController.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:FanController.App.Controls"
    xmlns:converters="using:FanController.App.Converters"
    xmlns:loc="using:FanController.App.Localization"
    Title="FanController — Local BLE control">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#101827">
        <Grid.Resources>
            <converters:BooleanVisibilityConverter x:Key="BooleanVisibility"/>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="#192538"/>
                <Setter Property="BorderBrush" Value="#304058"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="20,14"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Padding="28,22" ColumnSpacing="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE9CA;" Foreground="#5DD9C1" FontSize="32"/>
                    <TextBlock Text="FanController" FontSize="30" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding ConnectionLabel}" Foreground="#AABBD2" AutomationProperties.AutomationId="ConnectionStatus"/>
                <TextBlock Text="{Binding Firmware}" Foreground="#5DD9C1"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
                <ProgressRing IsActive="{Binding Busy}" Width="20" Height="20" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Margin="28,0,28,16" Padding="16,12" CornerRadius="5"
                Background="#4A2929" Visibility="{Binding HasError, Converter={StaticResource BooleanVisibility}}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE783;" Foreground="#FF9292" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock loc:Localizer.Key="ErrorBannerTitle" Text="Operation interrupted" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ErrorDetailsText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Foreground="#F4DCDC"/>
                </StackPanel>
            </Grid>
        </Border>
        <Pivot x:Name="MainPivot" Grid.Row="2" SelectionChanged="PivotSelectionChanged">
            <Pivot.Resources>
                <Thickness x:Key="PivotHeaderItemMargin">28,0,12,0</Thickness>
            </Pivot.Resources>
            <PivotItem x:Name="DashboardTabItem" loc:Localizer.Key="DashboardTab" Header="Dashboard" Margin="0" AutomationProperties.AutomationId="DashboardTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Spacing="16" Padding="28,0,28,24">
                        <TextBlock Text="{Binding LastUpdate}" Foreground="#AABBD2"/>
                        <ItemsControl ItemsSource="{Binding Sensors}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><charts:TwoColumnPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{Binding Title}" Foreground="#AABBD2"/>
                                            <TextBlock Text="{Binding Temperature}" FontSize="40" FontWeight="SemiBold" Foreground="#5DD9C1"/>
                                            <TextBlock Text="{Binding DisplayDetails}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock loc:Localizer.Key="DashboardCooling" Text="Cooling" FontSize="22" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding FanReadings}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><charts:TwoColumnPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding Title}" Foreground="#AABBD2"/>
                                            <TextBlock Text="{Binding Rpm}" FontSize="26" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DisplayDetails}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock loc:Localizer.Key="DashboardOfflineNote" Text="Values remain visible after a disconnect, but are no longer current. The ESP32 continues regulating independently."
                                   TextWrapping="Wrap" Foreground="#AABBD2"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem x:Name="HistoryTabItem" loc:Localizer.Key="HistoryTab" Header="History" Margin="0" AutomationProperties.AutomationId="HistoryTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Padding="28,0,28,24" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <ComboBox ItemsSource="{Binding History.Devices}" SelectedItem="{Binding History.SelectedDevice, Mode=TwoWay}"
                                      DisplayMemberPath="Label" Width="240" loc:Localizer.Key="HistoryControllerPicker" PlaceholderText="Controller history"/>
                            <ComboBox SelectedIndex="{Binding History.RangeIndex, Mode=TwoWay}" Width="190" loc:Localizer.Key="HistoryRange" AutomationProperties.Name="History range">
                                <ComboBoxItem loc:Localizer.Key="HistoryRangeHour" Content="Last hour"/><ComboBoxItem loc:Localizer.Key="HistoryRangeDay" Content="Last 24 hours"/>
                                <ComboBoxItem loc:Localizer.Key="HistoryRangeWeek" Content="Last 7 days"/><ComboBoxItem loc:Localizer.Key="HistoryRangeMonth" Content="Last 30 days"/>
                            </ComboBox>
                            <Button loc:Localizer.Key="HistoryRefresh" Content="Refresh" Command="{Binding History.RefreshCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding History.Message}" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock loc:Localizer.Key="HistoryTemperatures" Text="Temperatures • °C" FontSize="22" FontWeight="SemiBold"/>
                                <charts:LineChart Series="{Binding History.Temperatures}" IsTimeAxis="True"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock loc:Localizer.Key="HistorySpeeds" Text="Speeds • RPM" FontSize="22" FontWeight="SemiBold"/>
                                <charts:LineChart Series="{Binding History.Rpm}" IsTimeAxis="True"/>
                            </StackPanel>
                        </Border>
                        <TextBlock loc:Localizer.Key="HistoryNote" Text="Only measurements received while connected are recorded, including when the window is hidden. Offline periods are not reconstructed."
                                   TextWrapping="Wrap" Foreground="#AABBD2"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem x:Name="SettingsTabItem" loc:Localizer.Key="SettingsTab" Header="Settings" Margin="0" AutomationProperties.AutomationId="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" AutomationProperties.AutomationId="SettingsScrollViewer">
                    <StackPanel Padding="28,0,28,24" Spacing="16">
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock loc:Localizer.Key="SettingsLanguage" Text="Language" FontSize="20" FontWeight="SemiBold"/>
                                <ComboBox x:Name="LanguageSelector" SelectedIndex="0" SelectionChanged="LanguageChanged" Width="220">
                                    <ComboBoxItem Content="English"/><ComboBoxItem Content="Français"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <CheckBox loc:Localizer.Key="SettingsStartup" Content="Launch when Windows starts"
                                          IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="WindowsStartupCheckBox"/>
                                <TextBlock loc:Localizer.Key="SettingsStartupNote" Text="At sign-in, the app starts in the system tray and reconnects to the last controller."
                                           Foreground="#AABBD2" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock loc:Localizer.Key="SettingsNames" Text="Device names" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock loc:Localizer.Key="SettingsNamesNote" Text="Optional names are saved on this PC only and are never sent to the controller."
                                           Foreground="#AABBD2" TextWrapping="Wrap"/>
                                <TextBlock loc:Localizer.Key="SettingsProbes" Text="Probes" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding Sensors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="12" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ReferenceName}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding CustomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="40" loc:Localizer.Key="SettingsDeviceName" PlaceholderText="Custom name (optional)"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock loc:Localizer.Key="SettingsFans" Text="Fans" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding FanReadings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="12" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ReferenceName}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding CustomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="40" loc:Localizer.Key="SettingsDeviceName" PlaceholderText="Custom name (optional)"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding DeviceNamesStatus}" TextWrapping="Wrap" Foreground="#AABBD2"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock loc:Localizer.Key="SettingsConnection" Text="Controller connection" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ConnectionHeading}" VerticalAlignment="Center"
                                               Foreground="#AABBD2" AutomationProperties.AutomationId="ConnectionHeading"/>
                                </Grid>
                                <StackPanel Spacing="6" Visibility="{Binding Connected, Converter={StaticResource BooleanVisibility}}"
                                            AutomationProperties.AutomationId="ConnectedDetails">
                                    <TextBlock Text="{Binding ControllerName}" FontSize="18" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="ControllerName"/>
                                    <TextBlock Text="{Binding ControllerIdentifier}" IsTextSelectionEnabled="True"
                                           Foreground="#AABBD2" AutomationProperties.AutomationId="ControllerIdentifier"/>
                                    <TextBlock Text="{Binding LinkQuality}" AutomationProperties.AutomationId="LinkQuality" loc:Localizer.Key="SettingsLinkQuality" ToolTipService.ToolTip="Signal received by the ESP32: values closer to zero dBm indicate a stronger signal."/>
                                </StackPanel>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{Binding ConnectionVisible, Converter={StaticResource BooleanVisibility}}">
                                    <Button loc:Localizer.Key="SettingsScan" Content="Search (15 s)" Command="{Binding ScanCommand}" AutomationProperties.AutomationId="ScanButton"/>
                                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" loc:Localizer.Key="SettingsControllerPicker" DisplayMemberPath="Label" PlaceholderText="Select a controller" MinWidth="320"
                                              AutomationProperties.Name="BLE controller"/>
                                    <Button loc:Localizer.Key="SettingsConnect" Content="Connect / pair" Command="{Binding ConnectCommand}"
                                            Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="ConnectButton"/>
                                </StackPanel>
                                <Button Content="{Binding DisconnectLabel}" Command="{Binding DisconnectCommand}"
                                        Visibility="{Binding DisconnectVisible, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="DisconnectButton"/>
                                <Expander loc:Localizer.Key="SettingsPairingHelp" Header="First-time pairing instructions" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Visibility="{Binding ConnectionVisible, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="PairingHelp">
                                    <TextBlock loc:Localizer.Key="SettingsPairingInstructions" Text="1. On the ESP32, hold BOOT for 2 seconds, then release.&#x0a;2. Within 60 seconds, search for the controller, select it, then click Connect / pair.&#x0a;Later connections are automatic; BOOT is not needed again."
                                               TextWrapping="Wrap" Foreground="#AABBD2" AutomationProperties.AutomationId="PairingInstructions"/>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <TextBlock loc:Localizer.Key="OtaHeading" Text="Firmware update over Bluetooth" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock loc:Localizer.Key="OtaWarning" Text="Select a trusted application .bin file, not a merged flash image. Save settings first: unsaved RAM changes will be lost on restart. SHA-256 checks integrity, not the publisher. Keep the controller powered."
                                           TextWrapping="Wrap" Foreground="#AABBD2"/>
                                <TextBlock Text="{Binding FirmwareMessage}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding FirmwareTransferDetails}" Foreground="#AABBD2" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="FirmwareTransferDetails"/>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding FirmwareProgress}"
                                             Visibility="{Binding FirmwareUpdating, Converter={StaticResource BooleanVisibility}}"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="FirmwareUpdateButton" loc:Localizer.Key="OtaSelect" Content="Select firmware .bin"
                                            IsEnabled="{Binding CanUpdateFirmware}" Click="FirmwareUpdateClicked"/>
                                    <Button loc:Localizer.Key="OtaCancel" Content="Cancel update" Click="FirmwareCancelClicked"
                                            Visibility="{Binding FirmwareUpdating, Converter={StaticResource BooleanVisibility}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock loc:Localizer.Key="TachHeading" Text="TACH diagnostics over Bluetooth" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TachMessage}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button loc:Localizer.Key="TachCapture30" Content="Capture 30 s" Click="TachCapture30Clicked" IsEnabled="{Binding CanCaptureTach}" AutomationProperties.AutomationId="TachCapture30"/>
                                    <Button loc:Localizer.Key="TachCapture60" Content="Capture 60 s" Click="TachCapture60Clicked" IsEnabled="{Binding CanCaptureTach}" AutomationProperties.AutomationId="TachCapture60"/>
                                    <Button loc:Localizer.Key="TachCancel" Content="Cancel" Click="TachCancelClicked" IsEnabled="{Binding TachCapturing}"/>
                                    <Button loc:Localizer.Key="TachExport" Content="Export CSV" Click="TachExportClicked" IsEnabled="{Binding CanExportTach}" AutomationProperties.AutomationId="TachExport"/>
                                </StackPanel>
                                <ProgressBar Minimum="0" Maximum="{Binding TachDuration}" Value="{Binding TachSeconds}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding TachSeconds}"/>
                                    <TextBlock loc:Localizer.Key="TachSeconds" Text="seconds captured"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="16" Visibility="{Binding Connected, Converter={StaticResource BooleanVisibility}}"
                                    AutomationProperties.AutomationId="ControllerSettings">
                        <TextBlock loc:Localizer.Key="SettingsCurves" Text="Fan curves" FontSize="24" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock loc:Localizer.Key="SettingsCurvesNote" Text="The curve is linearly interpolated between points. Enable editing to change curves; disabling it keeps the draft."
                                       TextWrapping="Wrap" Foreground="#AABBD2" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding CurveEditing, Mode=TwoWay}" loc:Localizer.Key="SettingsCurveToggle" OnContent="Edit" OffContent="View" HorizontalAlignment="Right"
                                          MinWidth="0" VerticalAlignment="Center"
                                          AutomationProperties.Name="Curve editing" AutomationProperties.AutomationId="CurveEditingToggle"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>
                                            <charts:LineChart Series="{Binding Curve}" Editor="{Binding}"
                                                              IsEditing="{Binding IsEditing}" AutomationProperties.AutomationId="EditableCurve"
                                                              AutomationProperties.Name="{Binding Title}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock loc:Localizer.Key="SettingsFanControl" Text="Fan control" FontSize="22" FontWeight="SemiBold"/>
                        <UserControl IsEnabled="{Binding CanEdit}">
                            <ItemsControl ItemsSource="{Binding Fans}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                <TextBlock Text="{Binding Title}" Width="150" VerticalAlignment="Center"/>
                                                <ComboBox SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" Width="180" loc:Localizer.Key="SettingsFanMode" AutomationProperties.Name="Fan mode">
                                                    <ComboBoxItem loc:Localizer.Key="SettingsAutomatic" Content="{Binding AutomaticText}"/><ComboBoxItem loc:Localizer.Key="SettingsFixed" Content="{Binding FixedText}"/>
                                                </ComboBox>
                                                <TextBox Text="{Binding Duty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" loc:Localizer.Key="SettingsFixedPwm" AutomationProperties.Name="Fixed PWM percentage"/>
                                                <TextBlock loc:Localizer.Key="SettingsFixedMode" Text="{Binding FixedModeText}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </UserControl>
                        <StackPanel Visibility="{Binding CurveEditorVisible, Converter={StaticResource BooleanVisibility}}" Spacing="12" AutomationProperties.AutomationId="CurveEditorPanel">
                            <TextBlock loc:Localizer.Key="SettingsEditPoints" Text="Edit points" FontSize="22" Foreground="#FFB86B" AutomationProperties.AutomationId="CurveEditorTitle"/>
                            <UserControl IsEnabled="{Binding CanEdit}">
                                <ItemsControl ItemsSource="{Binding Profiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock loc:Localizer.Key="SettingsPointLabels" Text="{Binding PointLabelsText}"/>
                                                    <ItemsControl ItemsSource="{Binding Points}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnSpacing="16" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="140"/>
                                                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox Text="{Binding Temperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="180" loc:Localizer.Key="SettingsPointTemperature" AutomationProperties.Name="Point temperature"/>
                                                                    <TextBox Grid.Column="1" Text="{Binding Duty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140" loc:Localizer.Key="SettingsPointPwm" AutomationProperties.Name="Point PWM"/>
                                                                    <Button Grid.Column="3" loc:Localizer.Key="SettingsDeletePoint" Command="{Binding RemoveCommand}" ToolTipService.ToolTip="{Binding DeletePointToolTip}"
                                                                            AutomationProperties.Name="{Binding DeletePointToolTip}">
                                                                        <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </UserControl>
                            <TextBlock loc:Localizer.Key="SettingsPointConstraints" Text="2 to 8 points • −20 to 120 °C, strictly increasing • PWM 0 to 100%, non-decreasing." TextWrapping="Wrap"/>
                            <TextBlock loc:Localizer.Key="SettingsChartHelp" Text="On the chart: + adds a point; select a point, then use the trash button to delete it. Drag points to adjust temperature and PWM. Row delete buttons are also available."
                                       TextWrapping="Wrap" Foreground="#AABBD2"/>
                        </StackPanel>
                        <Border Background="#1B2B3C" BorderBrush="#304058" BorderThickness="1"
                                CornerRadius="8" Padding="12,9">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE946;" Foreground="#5DD9C1" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SettingsStatus}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" AutomationProperties.AutomationId="ConfigurationMessage"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFB86B" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button loc:Localizer.Key="SettingsApply" Content="1. Apply to RAM" Command="{Binding ApplyCommand}" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="ApplyButton"/>
                            <Button loc:Localizer.Key="SettingsSave" Content="2. Save to ESP32" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SaveButton"/>
                            <Button loc:Localizer.Key="SettingsRevert" Content="Discard changes" Command="{Binding AdoptCommand}" AutomationProperties.AutomationId="RevertButton"/>
                        </StackPanel>
                        <TextBlock loc:Localizer.Key="SettingsSafetyNote" Text="Apply changes fan behavior immediately. Save keeps these settings after restart. Thermal safety always takes priority."
                                   TextWrapping="Wrap" Foreground="#AABBD2"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
        <Grid Grid.Row="3" Padding="28,12" Background="#192538">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock loc:Localizer.Key="FooterNote" Text="Close or minimize → system tray • acquisition continues while the PC is connected"
                       VerticalAlignment="Center" FontSize="12" Foreground="#AABBD2" TextWrapping="Wrap"/>
            <Button Grid.Column="1" loc:Localizer.Key="FooterQuit" Content="Quit" Click="QuitClicked" AutomationProperties.AutomationId="QuitButton"/>
        </Grid>
    </Grid>
</Window>
